/ {
    model = "Hagzey STM32H743 Board";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
    };
};


&usart1 {
    pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
    pinctrl-names = "default";
    current-speed = <57600>;
    status = "okay";
};


&rcc {
 clocks = <&clk_hsi>;
 clock-frequency = <(((64) * 1000) * 1000)>;

    d1cpre = <1>;
    hpre = <1>;

    d1ppre = <1>;
    d2ppre1 = <1>;
    d2ppre2 = <1>;
    d3ppre = <1>;
};


&pwr {
    power-supply = "ldo";
};
